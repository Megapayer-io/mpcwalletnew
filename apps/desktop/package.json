{
  "name": "megapayer-desktop",
  "version": "1.0.0",
  "description": "Megapayer Desktop Wallet - Secure Multi-Chain Crypto Wallet",
  "main": "dist/main/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "next dev -p 3001",
    "dev:main": "wait-on http://localhost:3001 && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "next build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "pack": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --publish=never",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@evm-wallet/sdk": "file:./lib/sdk",
    "@tanstack/react-query": "^5.51.0",
    "autoprefixer": "^10",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.400.0",
    "next": "14.2.5",
    "postcss": "^8",
    "react": "^18",
    "react-dom": "^18",
    "tailwindcss": "^3.4.1",
    "viem": "^2.21.0",
    "wagmi": "^2.12.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.megapayer.desktop",
    "productName": "Megapayer Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
