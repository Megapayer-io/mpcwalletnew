{
  "name": "evm-wallet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:desktop": "pnpm --filter megapayer-desktop dev",
    "dev:all": "concurrently \"pnpm dev:web\" \"pnpm dev:desktop\"",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter megapayer-desktop build",
    "dist:desktop": "pnpm --filter megapayer-desktop dist",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^20",
    "concurrently": "^8.2.2",
    "turbo": "^1.13.4",
    "typescript": "^5"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.10",
    "@reown/appkit-adapter-ethers": "^1.8.10",
    "@reown/appkit-adapter-wagmi": "^1.8.10",
    "@types/qrcode": "^1.5.5",
    "playwright-core": "^1.56.1",
    "puppeteer-core": "^24.25.0",
    "qrcode": "^1.5.4"
  }
}